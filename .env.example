# Option A: put your key directly here (this file is gitignored once copied to .env,
# your key never gets committed)
ANTHROPIC_API_KEY=

# Option B: point at a file containing your key instead, e.g. ANTHROPIC_API_KEY_FILE=~/.anthropic_key
ANTHROPIC_API_KEY_FILE=

# Model used for hints / review / solutions
CLAUDE_MODEL=claude-sonnet-5
